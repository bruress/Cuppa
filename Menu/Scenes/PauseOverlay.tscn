[sub_resource type="Shader" id="Shader_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_tex : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_strength : hint_range(0.0, 4.0) = 2.4;

void fragment() {
	vec2 uv = SCREEN_UV;
	vec2 px = SCREEN_PIXEL_SIZE * blur_strength;
	vec4 c = texture(screen_tex, uv) * 0.28;
	c += texture(screen_tex, uv + vec2(px.x, 0.0)) * 0.16;
	c += texture(screen_tex, uv - vec2(px.x, 0.0)) * 0.16;
	c += texture(screen_tex, uv + vec2(0.0, px.y)) * 0.16;
	c += texture(screen_tex, uv - vec2(0.0, px.y)) * 0.16;
	c += texture(screen_tex, uv + px) * 0.04;
	c += texture(screen_tex, uv - px) * 0.04;
	COLOR = c;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_blur"]
shader = SubResource("Shader_blur")
shader_parameter/blur_strength = 4.0

